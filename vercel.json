{
  "functions": {
    "api/**": {
      "includeFiles": "node_modules/pdfkit/js/data/**",
      "maxDuration": 30
    },
    "api/index.ts": {
      "includeFiles": "node_modules/pdfkit/js/data/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
